# Discord Bot
DISCORD_TOKEN=

# Datenbank
# Lokal (SQLite): sqlite+aiosqlite:///./dev.db
# Prod (MariaDB): mysql+asyncmy://user:password@host:3306/wikingerbot
DATABASE_URL=sqlite+aiosqlite:///./dev.db
# Alternativ zu DATABASE_URL (so macht es die AMP-Vorlage): einzelne Felder, daraus wird
# eine MariaDB-URL gebaut - Sonderzeichen im Passwort muessen NICHT kodiert werden.
# Greift nur, wenn DB_HOST gesetzt und DATABASE_URL nicht gesetzt ist.
# DB_HOST=10.0.0.107
# DB_PORT=3306
# DB_NAME=wikingerbot
# DB_USER=wikingerbot
# DB_PASSWORD=

# Beim Start automatisch "alembic upgrade head" ausfuehren (Standard: true)
AUTO_MIGRATE=true
LOG_LEVEL=INFO

# Discord OAuth2 (WebUI-Login)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/callback

# JWT-Signatur fuer Session-Cookies
JWT_SECRET=change-me

# WebUI (Phase 3): erlaubte Frontend-Origins fuer CORS (JSON-Liste!) und
# Ziel-URL fuer den Redirect nach dem OAuth2-Login
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# AMP (CubeCoders) Controller - ein globaler Login fuer alle Instanzen,
# einzelne Server werden ueber ihre amp_instance_id adressiert (siehe Server-Modell)
AMP_URL=http://localhost:8080
AMP_USER=
AMP_PASSWORD=
